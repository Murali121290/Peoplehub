# =========================================================================
# BACKEND CONFIGURATION
# =========================================================================

# Timezone
TZ=UTC

# Frontend and Backend Ports
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Flask Config
SECRET_KEY=wms-enterprise-secret-key-2024
JWT_SECRET_KEY=wms-enterprise-super-secret-jwt-key-2026-secure
BACKEND_URL=http://localhost:5000

# Database Configuration (PostgreSQL)
# Note: Inside Docker, use service name 'postgres' instead of 'localhost'
# Use %40 to URL-encode the '@' character in the password
DATABASE_URL=postgresql://postgres:$$vBr%402150@postgres:5432/wms_db
POSTGRES_PASSWORD=$$vBr@2150
POSTGRES_DB=wms_db
POSTGRES_USER=postgres
# Mail Server Configuration
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=selvabharathp@s4carlisle.com
MAIL_PASSWORD=$$vBr@2150
MAIL_DEFAULT_SENDER=selvabharathp@s4carlisle.com

# EmailJS Configuration
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# =========================================================================
# FRONTEND CONFIGURATION
