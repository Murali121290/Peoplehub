# =========================================================================
# BACKEND CONFIGURATION
# =========================================================================

# Timezone
TZ=UTC

# Frontend and Backend Ports
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Flask Config
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_random_secret_key_here_min_32_chars

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_random_jwt_secret_key_here_min_32_chars

BACKEND_URL=http://localhost:5000

# Database Configuration (PostgreSQL)
# Note: Inside Docker, use service name 'postgres' instead of 'localhost'
# Format: postgresql://username:password@host:port/database
# URL-encode special characters in password (e.g., @ becomes %40)
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/wms_db

POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=wms_db
POSTGRES_USER=postgres

# Mail Server Configuration
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@company.com
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER=your_email@company.com

# EmailJS Configuration
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# =========================================================================
# FRONTEND CONFIGURATION
# =========================================================================

# Frontend API URL (points to FastAPI backend - base URL, /api prefix is added by axios baseURL)
VITE_API_URL=http://localhost:5000

# CORS Origins (comma-separated list of allowed origins for backend)
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
